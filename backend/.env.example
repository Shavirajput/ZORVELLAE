# =============================================
# ZORVELLAE SERVER — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# =============================================

# --- Application ---
NODE_ENV=development
PORT=5000

# --- MongoDB ---
# Option 1: Local MongoDB (recommended for development)
# Install MongoDB Community Edition: https://www.mongodb.com/try/download/community
MONGO_URI=mongodb://localhost:27017/zorvellae

# Option 2: MongoDB Atlas free cluster (cloud)
# Create account at https://cloud.mongodb.com (free tier available)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/zorvellae?retryWrites=true&w=majority

# --- JWT Authentication ---
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_MIN_64_CHARS
JWT_EXPIRES_IN=7d
# Keep the administrator session key separate from customer JWT_SECRET.
JWT_ADMIN_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_MIN_64_CHARS
JWT_ADMIN_EXPIRES_IN=1d

# --- Payment Gateway (choose one, use TEST keys during development) ---
# Razorpay (India) — free test mode: https://razorpay.com
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME

# Stripe (international) — free test mode: https://stripe.com
# STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# --- Email (Nodemailer) ---
# Gmail: enable App Passwords at https://myaccount.google.com/security
# Or use Ethereal for dev testing: https://ethereal.email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_YOUR_EMAIL
SMTP_PASS=REPLACE_WITH_APP_PASSWORD
EMAIL_FROM=ZORVELLAE <noreply@zorvellae.com>

# --- File Uploads ---
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=5

# --- Client URL (for CORS) ---
CLIENT_URL=http://localhost:5173
